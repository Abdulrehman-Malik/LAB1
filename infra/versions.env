# Image tag deployed for each service. Git is the source of truth for what runs:
#   - change a tag here and run  bash scripts/deploy.sh             (whole stack), or
#   - run  bash scripts/deploy-service.sh <service> <tag>           (one service; it updates this file for you)
#   - or   bash scripts/ci.sh <service>                             (test, build, deploy, smoke test, auto-rollback)
# Never deploy "latest": a numbered tag tells you exactly which build is running and lets you roll back.
CUSTOMERS_API_TAG=6
BILLING_API_TAG=4
ORDERS_API_TAG=5
DOCUMENTS_API_TAG=3
NOTIFICATION_WORKER_TAG=3
WEB_PORTAL_TAG=3
AUTOSCALER_TAG=4
