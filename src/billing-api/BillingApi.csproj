<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>BillingApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server side of the shared contract: generates BillingService.BillingServiceBase -->
    <Protobuf Include="..\shared-protos\billing.proto" GrpcServices="Server" Link="Protos\billing.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\Lab.Shared\Lab.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>
</Project>
